[
  {
    "doctype": "Email Template",
    "name": "Anticipatory Action Submission",
    "subject": "Anticipatory Action Submission Received \u2013 Reference {{ doc.name }}",
    "use_html": 1,
    "response_html": "{% set site_url = frappe.utils.get_url() %}\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /></head>\n<body style=\"margin:0;padding:0;background:#F3F4F6;font-family:Arial,Helvetica,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F4F6;padding:32px 0\">\n  <tr><td align=\"center\">\n    <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);\">\n\n      <!-- Header -->\n      <tr>\n        <td style=\"background:#CC0000;padding:20px 32px;text-align:center;\">\n          <p style=\"margin:0;font-size:18px;font-weight:700;color:#fff;\">Kenya Anticipatory Action</p>\n          <p style=\"margin:4px 0 0;font-size:12px;color:#FECACA;\">Data Collection &amp; Monitoring Platform</p>\n        </td>\n      </tr>\n\n      <!-- Body -->\n      <tr>\n        <td style=\"padding:32px;\">\n          <p style=\"font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;\">Dear {{ doc.reporting_person }},</p>\n          <p style=\"font-size:14px;color:#374151;line-height:1.6;margin-bottom:20px;\">\n            Thank you for submitting your Anticipatory Action report. Your entry has been received and recorded successfully.\n          </p>\n\n          <!-- Reference box -->\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;margin-bottom:24px;\">\n            <tr>\n              <td style=\"padding:16px 20px;\">\n                <p style=\"font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#9CA3AF;margin-bottom:4px;\">Your Reference Number</p>\n                <p style=\"font-size:20px;font-weight:700;color:#CC0000;margin:0;\">{{ doc.name }}</p>\n              </td>\n            </tr>\n          </table>\n\n          <!-- Summary -->\n          <p style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#9CA3AF;margin-bottom:12px;\">Submission Summary</p>\n          <table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;margin-bottom:24px;\">\n            <tr style=\"border-bottom:1px solid #F3F4F6;\">\n              <td style=\"font-size:12px;color:#6B7280;width:45%;\">Organization</td>\n              <td style=\"font-size:13px;font-weight:600;color:#1A1A1A;\">{{ doc.implementing_organization }}</td>\n            </tr>\n            <tr style=\"border-bottom:1px solid #F3F4F6;\">\n              <td style=\"font-size:12px;color:#6B7280;\">Hazard Type</td>\n              <td style=\"font-size:13px;font-weight:600;color:#1A1A1A;\">{{ doc.anticipated_hazard }}{% if doc.other_anticipated_hazards %} &ndash; {{ doc.other_anticipated_hazards }}{% endif %}</td>\n            </tr>\n            <tr style=\"border-bottom:1px solid #F3F4F6;\">\n              <td style=\"font-size:12px;color:#6B7280;\">Activation Date</td>\n              <td style=\"font-size:13px;font-weight:600;color:#1A1A1A;\">{{ frappe.utils.format_date(doc.activation_start_date, \"MMMM d, yyyy\") if doc.activation_start_date else \"&mdash;\" }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:12px;color:#6B7280;\">Intervention Areas</td>\n              <td style=\"font-size:13px;font-weight:600;color:#1A1A1A;\">{{ doc.anticipatory_action_details | length }} entr{{ \"y\" if doc.anticipatory_action_details | length == 1 else \"ies\" }}</td>\n            </tr>\n          </table>\n\n          <p style=\"font-size:13px;color:#374151;line-height:1.6;margin-bottom:24px;\">\n            A full copy of your submission is attached to this email as a PDF for your records.\n          </p>\n\n          <hr style=\"border:none;border-top:1px solid #E5E7EB;margin:24px 0;\" />\n\n          <p style=\"font-size:12px;color:#6B7280;line-height:1.6;\">\n            For questions or support, contact us at\n            <a href=\"mailto:hindada.boneya@icha.net\" style=\"color:#CC0000;\">hindada.boneya@icha.net</a> or\n            <a href=\"mailto:info@ndoc.go.ke\" style=\"color:#CC0000;\">info@ndoc.go.ke</a>.\n          </p>\n        </td>\n      </tr>\n\n      <!-- Footer -->\n      <tr>\n        <td style=\"background:#F9FAFB;padding:16px 32px;border-top:1px solid #E5E7EB;text-align:center;\">\n          <p style=\"font-size:11px;color:#9CA3AF;margin:0;\">Made by <strong style=\"color:#6B7280;\">Kenya Red Cross Digital Transformation</strong></p>\n        </td>\n      </tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>"
  }
]
