 "message": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /></head>\n<body style=\"margin:0;padding:0;background:#F3F4F6;font-family:Arial,Helvetica,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F4F6;padding:40px 0;\">\n  <tr><td align=\"center\">\n    <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);\">\n      <tr>\n        <td style=\"background:#1F2937;border-bottom:3px solid #CC0000;padding:28px 40px;text-align:center;\">\n          <p style=\"margin:0;font-size:20px;font-weight:700;color:#ffffff;\">Kenya Anticipatory Action</p>\n          <p style=\"margin:6px 0 0;font-size:12px;color:#9CA3AF;\">Data Collection &amp; Monitoring Platform</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:36px 40px 28px;\">\n          <p style=\"font-size:16px;font-weight:700;color:#1A1A1A;margin:0 0 8px;\">Dear {{ doc.reporting_person }},</p>\n          <p style=\"font-size:14px;color:#374151;line-height:1.7;margin:0 0 28px;\">Good news. Your Anticipatory Action submission has been <strong style=\"color:#059669;\">reviewed and approved</strong> by the TWG Secretariat. A full copy of your submission is attached to this email as a PDF for your records.</p>\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ECFDF5;border:1.5px solid #A7F3D0;border-radius:8px;margin-bottom:28px;\">\n            <tr><td style=\"padding:18px 22px;\">\n              <p style=\"font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#9CA3AF;margin:0 0 6px;\">Reference Number</p>\n              <p style=\"font-size:22px;font-weight:700;color:#059669;margin:0;\">{{ doc.name }}</p>\n              <p style=\"font-size:11px;color:#6B7280;margin:6px 0 0;\">Approved and recorded in the national register.</p>\n            </td></tr>\n          </table>\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #E5E7EB;border-radius:8px;overflow:hidden;margin-bottom:28px;\">\n            <tr style=\"background:#F9FAFB;\"><td style=\"font-size:12px;color:#6B7280;padding:10px 14px;border-bottom:1px solid #E5E7EB;width:44%;\">Organization</td><td style=\"font-size:13px;font-weight:600;color:#1A1A1A;padding:10px 14px;border-bottom:1px solid #E5E7EB;\">{{ doc.implementing_organization }}</td></tr>\n            <tr><td style=\"font-size:12px;color:#6B7280;padding:10px 14px;border-bottom:1px solid #E5E7EB;\">Hazard Type</td><td style=\"font-size:13px;font-weight:600;color:#1A1A1A;padding:10px 14px;border-bottom:1px solid #E5E7EB;\">{{ doc.anticipated_hazard }}</td></tr>\n            <tr style=\"background:#F9FAFB;\"><td style=\"font-size:12px;color:#6B7280;padding:10px 14px;\">Activation Date</td><td style=\"font-size:13px;font-weight:600;color:#1A1A1A;padding:10px 14px;\">{{ frappe.utils.format_date(doc.activation_start_date, \"d MMMM yyyy\") if doc.activation_start_date else \"-\" }}</td></tr>\n          </table>\n          <hr style=\"border:none;border-top:1px solid #E5E7EB;margin:0 0 24px;\" />\n          <p style=\"font-size:12px;color:#6B7280;line-height:1.7;margin:0;\">For questions or support, please contact us at <a href=\"mailto:aadashboard@ndoc.go.ke\" style=\"color:#CC0000;text-decoration:none;\">aadashboard@ndoc.go.ke</a>.</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"background:#F9FAFB;padding:16px 40px;border-top:1px solid #E5E7EB;text-align:center;\">\n          <p style=\"font-size:11px;color:#9CA3AF;margin:0;\">National Disaster Operations Centre &middot; Anticipatory Action Platform</p>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>\n",
