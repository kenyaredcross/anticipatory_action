 "font_size": 0,
 "html": "<div style=\"padding:24px 30px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#1A1A1A;\">\n\n  <div style=\"border-bottom:3px solid #CC0000;padding-bottom:16px;margin-bottom:22px;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n      <td style=\"vertical-align:middle;\">\n        <div style=\"font-size:20px;font-weight:700;color:#1A1A1A;line-height:1.2;\">Anticipatory Action</div>\n        <div style=\"font-size:12px;color:#6B7280;margin-top:2px;\">Data Collection &amp; Monitoring Platform</div>\n      </td>\n      <td style=\"vertical-align:middle;text-align:right;\">\n        <div style=\"font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#6B7280;\">Status</div>\n        <div style=\"font-size:13px;font-weight:700;color:#059669;margin-top:3px;\">{{ doc.status or \"Pending\" }}</div>\n      </td>\n    </tr></table>\n  </div>\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9FAFB;border:1px solid #E5E7EB;border-left:4px solid #CC0000;border-radius:8px;margin-bottom:22px;\">\n    <tr><td style=\"padding:14px 20px;\">\n      <div style=\"font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#6B7280;\">Reference Number</div>\n      <div style=\"font-size:18px;font-weight:700;color:#1A1A1A;margin-top:3px;\">{{ doc.name }}</div>\n    </td></tr>\n  </table>\n\n  <div style=\"font-size:15px;font-weight:700;color:#1A1A1A;border-left:4px solid #CC0000;padding-left:10px;margin:0 0 12px;\">1. Implementing Organization</div>\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:20px;font-size:13px;\">\n    <tr>\n      <td style=\"padding:5px 0;width:50%;\"><span style=\"color:#6B7280;\">Organization:</span> {{ doc.implementing_organization or \"-\" }}</td>\n      <td style=\"padding:5px 0;width:50%;\"><span style=\"color:#6B7280;\">Type:</span> {{ doc.entity_or_organization_type or \"-\" }}{% if doc.other_organization_entity %} - {{ doc.other_organization_entity }}{% endif %}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Funding source:</span> {{ doc.funding_source or \"-\" }}</td>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Reporting person:</span> {{ doc.reporting_person or \"-\" }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Email:</span> {{ doc.reporter_email or \"-\" }}</td>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Phone:</span> {{ doc.reporter_phone_number or \"-\" }}</td>\n    </tr>\n  </table>\n\n  <div style=\"font-size:15px;font-weight:700;color:#1A1A1A;border-left:4px solid #CC0000;padding-left:10px;margin:0 0 12px;\">2. Hazard &amp; Anticipatory Actions</div>\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:20px;font-size:13px;\">\n    <tr>\n      <td style=\"padding:5px 0;width:50%;\"><span style=\"color:#6B7280;\">Hazard:</span> {{ doc.anticipated_hazard or \"-\" }}{% if doc.other_anticipated_hazards %} - {{ doc.other_anticipated_hazards }}{% endif %}</td>\n      <td style=\"padding:5px 0;width:50%;\"><span style=\"color:#6B7280;\">Implementing partners:</span> {{ doc.implementing_partners or \"-\" }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Activation start:</span> {{ frappe.utils.format_date(doc.activation_start_date, \"d MMMM yyyy\") if doc.activation_start_date else \"-\" }}</td>\n      <td style=\"padding:5px 0;\"><span style=\"color:#6B7280;\">Proposed end:</span> {{ frappe.utils.format_date(doc.activation_end_date, \"d MMMM yyyy\") if doc.activation_end_date else \"-\" }}</td>\n    </tr>\n  </table>\n\n  {% if doc.anticipatory_action_details %}\n  <div style=\"font-size:15px;font-weight:700;color:#1A1A1A;border-left:4px solid #CC0000;padding-left:10px;margin:0 0 12px;\">3. Anticipatory Action Details</div>\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:11px;border:1px solid #E5E7EB;margin-bottom:20px;\">\n    <thead><tr style=\"background:#CC0000;color:#fff;\">\n      <th style=\"padding:8px 10px;text-align:left;\">County / Sub-county</th>\n      <th style=\"padding:8px 10px;text-align:left;\">Sector</th>\n      <th style=\"padding:8px 10px;text-align:left;\">Intervention</th>\n      <th style=\"padding:8px 10px;text-align:right;\">Budget (KES)</th>\n      <th style=\"padding:8px 10px;text-align:right;\">People</th>\n      <th style=\"padding:8px 10px;text-align:left;\">Status</th>\n    </tr></thead>\n    <tbody>\n    {% for row in doc.anticipatory_action_details %}\n      <tr style=\"background:{{ '#F9FAFB' if loop.index0 % 2 == 0 else '#ffffff' }};\">\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;\"><strong>{{ row.county or \"-\" }}</strong>{% if row.subcounty %}<br><span style=\"color:#6B7280;font-size:10px;\">{{ row.subcounty }}</span>{% endif %}</td>\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;\">{{ row.sector or \"-\" }}</td>\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;\">{{ row.describe_the_anticipatory_action_intervention or \"-\" }}</td>\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;text-align:right;\">{{ \"{:,.0f}\".format(row.amount_for_anticipatory_action_kes) if row.amount_for_anticipatory_action_kes else \"-\" }}</td>\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;text-align:right;\">{{ \"{:,.0f}\".format(row.number_of_people_targeted) if row.number_of_people_targeted else \"-\" }}</td>\n        <td style=\"padding:7px 10px;border-bottom:1px solid #E5E7EB;\">{{ row.status_of_the_early_action or \"Planned\" }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  {% endif %}\n\n  {% if doc.triggers_and_thresholds or doc.lessons_learnt or doc.challenges or doc.recommendations %}\n  <div style=\"font-size:15px;font-weight:700;color:#1A1A1A;border-left:4px solid #CC0000;padding-left:10px;margin:0 0 12px;\">4. Additional Information</div>\n  <div style=\"font-size:13px;line-height:1.6;margin-bottom:20px;\">\n    {% if doc.triggers_and_thresholds %}<p style=\"margin:0 0 10px;\"><span style=\"color:#6B7280;font-weight:700;\">Triggers &amp; thresholds:</span> {{ doc.triggers_and_thresholds }}</p>{% endif %}\n    {% if doc.lessons_learnt %}<p style=\"margin:0 0 10px;\"><span style=\"color:#6B7280;font-weight:700;\">Key lessons learnt:</span> {{ doc.lessons_learnt }}</p>{% endif %}\n    {% if doc.challenges %}<p style=\"margin:0 0 10px;\"><span style=\"color:#6B7280;font-weight:700;\">Challenges:</span> {{ doc.challenges }}</p>{% endif %}\n    {% if doc.recommendations %}<p style=\"margin:0 0 10px;\"><span style=\"color:#6B7280;font-weight:700;\">Recommendations:</span> {{ doc.recommendations }}</p>{% endif %}\n  </div>\n  {% endif %}\n\n  <div style=\"margin-top:24px;padding-top:14px;border-top:1px solid #E5E7EB;text-align:center;font-size:10px;color:#9CA3AF;\">\n    National Disaster Operations Centre &middot; Anticipatory Action Platform\n  </div>\n\n</div>",
